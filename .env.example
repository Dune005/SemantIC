# SemantIC – Umgebungsvariablen-Vorlage
# Kopieren nach .env.local (Repo-Root) und Werte eintragen.
# .env.local ist gitignored und darf nie committet werden.

# --- Pflicht: LLM-API-Keys ---
# Google Gemini (primäres Analyse-LLM, Call 1)
GOOGLE_GENERATIVE_AI_API_KEY=
# Anthropic Claude (Ästhetik-Score, Call 2)
ANTHROPIC_API_KEY=

# --- Deployment / Frontend (Rate-Limit) ---
# Upstash Redis für das IP-basierte Rate-Limit.
# Lokal optional: ohne diese Werte läuft der Dev-Betrieb ohne Limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Rate-Limit-Bypass (Demo-Zugang): Einlöse-Code + Server-Geheimnis.
SEMANTIC_BYPASS_CODE=
SEMANTIC_BYPASS_SECRET=

# --- Optional ---
# Nur nötig, wenn Analyse- oder Ästhetik-Call über OpenRouter laufen soll.
OPENROUTER_API_KEY=
# Externe Nebencalls (Ästhetik-Zusatzwert / CLIP-Abgleich).
# Ohne diese Werte läuft die Analyse ohne die Zusatzsignale weiter.
MODAL_AESTHETIC_URL=
MODAL_AESTHETIC_BEARER=
MODAL_CLIP_URL=
MODAL_CLIP_BEARER=
# Debug: Wert 1 aktiviert das Roh-Logging der LLM-Antworten auch in Produktion.
SEMANTIC_DEBUG_RAW=
